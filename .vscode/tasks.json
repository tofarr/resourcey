{
    // Pre-launch tasks backing .vscode/launch.json. Each example is a
    // standalone uv project, so a task runs `uv sync` in that example's
    // directory (creating/reusing examples/<name>/.venv) and, for the SQL
    // examples, applies the Alembic migration before the server starts.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "examples: sync 01_message_board",
            "type": "shell",
            "command": "uv sync",
            "options": { "cwd": "${workspaceFolder}/examples/01_message_board" },
            "problemMatcher": []
        },
        {
            "label": "examples: sync 02_mongodb",
            "type": "shell",
            "command": "uv sync",
            "options": { "cwd": "${workspaceFolder}/examples/02_mongodb" },
            "problemMatcher": []
        },
        {
            "label": "examples: sync 03_api_key_auth",
            "type": "shell",
            "command": "uv sync",
            "options": { "cwd": "${workspaceFolder}/examples/03_api_key_auth" },
            "problemMatcher": []
        },
        {
            "label": "examples: migrate 01_message_board",
            "type": "shell",
            "command": "uv run --env-file .env alembic upgrade head",
            "options": { "cwd": "${workspaceFolder}/examples/01_message_board" },
            "dependsOn": "examples: sync 01_message_board",
            "problemMatcher": []
        },
        {
            "label": "examples: migrate 03_api_key_auth",
            "type": "shell",
            "command": "uv run resourcey migrate upgrade",
            "options": { "cwd": "${workspaceFolder}/examples/03_api_key_auth" },
            "dependsOn": "examples: sync 03_api_key_auth",
            "problemMatcher": []
        }
    ]
}
