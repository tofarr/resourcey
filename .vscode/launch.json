{
    // Debug configurations for the example apps under examples/.
    //
    // Each example is a standalone uv project with its own virtualenv
    // (examples/<name>/.venv) and a committed .env. The examples (01, 02, 03)
    // do no .env loading, so their configs pass "--env-file .env" explicitly.
    // Each config sets "cwd" to the example directory — that is what makes the
    // example's database apply.
    //
    // The preLaunchTask (see tasks.json) syncs the example's virtualenv and
    // applies the Alembic migration, so a fresh clone can be debugged without
    // any manual setup. Uvicorn's --reload is intentionally omitted: the
    // reloader restarts the process and detaches the debugger.
    //
    // The "python" paths are the Linux/macOS venv layout; on Windows use
    // ".venv\\Scripts\\python.exe". See examples/*/README.md for details.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug 01 — Message Board (SQLite)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["message_board.app:app", "--env-file", ".env", "--port", "8081"],
            "cwd": "${workspaceFolder}/examples/01_message_board",
            "python": "${workspaceFolder}/examples/01_message_board/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "examples: migrate 01_message_board"
        },
        {
            "name": "Debug 02 — Message Board (MongoDB, embedded)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["message_board.app:app", "--env-file", ".env", "--port", "8082"],
            "cwd": "${workspaceFolder}/examples/02_mongodb",
            "python": "${workspaceFolder}/examples/02_mongodb/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "examples: sync 02_mongodb"
        },
        {
            "name": "Debug 03 — API Key Auth (SQLite)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["api_key_auth.app:app", "--env-file", ".env", "--port", "8083"],
            "cwd": "${workspaceFolder}/examples/03_api_key_auth",
            "python": "${workspaceFolder}/examples/03_api_key_auth/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "examples: migrate 03_api_key_auth"
        },
        {
            "name": "Debug 04 — Simple Roles (SQLite)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["simple_roles.app:app", "--env-file", ".env", "--port", "8084"],
            "cwd": "${workspaceFolder}/examples/04_simple_roles",
            "python": "${workspaceFolder}/examples/04_simple_roles/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "examples: migrate 04_simple_roles"
        },
        {
            "name": "Debug 05 — Full RBAC (SQLite)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["full_rbac.app:app", "--env-file", ".env", "--port", "8085"],
            "cwd": "${workspaceFolder}/examples/05_full_rbac",
            "python": "${workspaceFolder}/examples/05_full_rbac/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "examples: migrate 05_full_rbac"
        },
        {
            "name": "Debug 06 — File Store (local medium, SQLite)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["file_store_example.app:app", "--env-file", ".env", "--port", "8086"],
            "cwd": "${workspaceFolder}/examples/06_filestore",
            "python": "${workspaceFolder}/examples/06_filestore/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "examples: migrate 06_filestore"
        },
        {
            "name": "Debug 07 — OAuth (SQLite)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["oauth_example.app:app", "--env-file", ".env", "--port", "8087"],
            "cwd": "${workspaceFolder}/examples/07_oauth",
            "python": "${workspaceFolder}/examples/07_oauth/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": false,
            "preLaunchTask": "examples: migrate 07_oauth"
        }
    ],
    "compounds": [
        {
            "name": "Debug all examples",
            "configurations": [
                "Debug 01 — Message Board (SQLite)",
                "Debug 02 — Message Board (MongoDB, embedded)",
                "Debug 03 — API Key Auth (SQLite)",
                "Debug 04 — Simple Roles (SQLite)",
                "Debug 05 — Full RBAC (SQLite)",
                "Debug 06 — File Store (local medium, SQLite)",
                "Debug 07 — OAuth (SQLite)"
            ],
            "stopAll": true
        }
    ]
}
