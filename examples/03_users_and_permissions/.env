# Users-and-permissions example environment.
# Uses the stock FrameworkConfig — no config subclass needed.

# Manifest import path (module:attr). The migrations CLI imports this to
# materialise the resource tables before Alembic diffs.
RESOURCEY_MANIFEST=users_and_permissions.app:manifest

# SQLite file database (relative to the working directory). The full_db_url
# escape hatch bypasses the structured protocol://user:pass@host:port/db
# assembly, which doesn't apply to SQLite's path-based URLs.
RESOURCEY_DATABASE_FULL_DB_URL=sqlite+aiosqlite:///users_and_permissions.db

# App server.
RESOURCEY_HOST=0.0.0.0
RESOURCEY_PORT=8083

# Encryption key required for JWE auth tokens + cursor encryption. Throwaway
# dev key — replace with a real secret before any deployment.
RESOURCEY_ENCRYPTION_KEY_ID=dev
RESOURCEY_ENCRYPTION_KEY_VALUE=dev-secret-key-for-example-03

# Session cookie over HTTP for local dev (the OpenAPI docs page can log in).
# In production set SECURE=true and SAME_SITE=strict behind HTTPS.
RESOURCEY_AUTH_COOKIE_SECURE=false
RESOURCEY_AUTH_COOKIE_SAMESITE=lax
