# Message-board example environment.
# Copy to `.env` and edit, or export these vars before `resourcey run`.

# Use the message-board config (SQLite by default). Comment out to fall back to
# the stock FrameworkConfig (Postgres via RESOURCEY_DATABASE_*).
RESOURCEY_CONFIG_CLASS=examples.message_board.config.MessageBoardConfig

# Explicit resource set (JSON array of dotted import paths).
RESOURCEY_RESOURCES=["examples.message_board.thread.Thread","examples.message_board.message.Message"]

# SQLite file database (relative to the working directory).
RESOURCEY_DATABASE_PROTOCOL=sqlite+aiosqlite
RESOURCEY_DATABASE_DB_NAME=message_board.db

# App server.
RESOURCEY_HOST=0.0.0.0
RESOURCEY_PORT=8081
