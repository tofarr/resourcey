# API-key-auth example environment.
# Uses the stock FrameworkConfig — no config subclass needed.

# Manifest import path (module:attr). The migrations CLI imports this to
# materialise the resource tables before Alembic diffs.
RESOURCEY_MANIFEST=api_key_auth.app:manifest

# SQLite file database (relative to the working directory). The full_db_url
# escape hatch bypasses the structured protocol://user:pass@host:port/db
# assembly, which doesn't apply to SQLite's path-based URLs.
RESOURCEY_DATABASE_FULL_DB_URL=sqlite+aiosqlite:///api_key_auth.db

# Encryption key — required for cursor pagination (search next_cursor is an
# encrypted JWE). Throwaway dev key; replace with a real secret before any
# deployment.
RESOURCEY_ENCRYPTION_KEY_ID=dev
RESOURCEY_ENCRYPTION_KEY_VALUE=dev-secret-key-for-example-03

# Global security posture (issue #62): the auth2 API-key DependencyBuilder
# requires a valid key on every resource before its service opens storage.
# Keep this file out of production as-is — it demonstrates the mechanism.
DEPENDENCY_BUILDER_CLASS=resourcey.auth2.auth2_api_key.ApiKeyDependencyBuilder

# Accepted API keys. Any listed key authenticates a request, so keys can be
# rotated by adding the new one alongside the old, deploying, then removing the
# old. Set the header `X-API-Key: example-api-key` (or
# `Authorization: Bearer example-api-key`).
DEPENDENCY_BUILDER_API_KEYS_0=example-api-key
