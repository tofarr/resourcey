# API-key-auth example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uvicorn api_key_auth.app:app --env-file .env --port 8083
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL / _PASSWORD; cursors are encrypted with
# APP_ENCRYPTION_KEY_ID / _VALUE; accepted keys are APP_API_KEYS_<n>_ID / _KEY.

# SQLite file database (relative to the working directory). The URL carries the
# full connection string; the scheme selects the driver.
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///api_key_auth.db

# Cursor-encryption key. An absent key degrades to a loud dev default
# ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=api-key-auth-dev-cursor-key

# Accepted API keys (issue #118). Each entry needs an id and the plaintext key;
# the plaintext is read here and hashed on load, never stored in a table. A
# request that presents one of these keys gets the full REST API, and anything
# else gets 401. Keys can be rotated by adding the new one alongside the old,
# deploying, then removing the old. Set the header `X-API-Key: example-api-key`
# (or `Authorization: Bearer example-api-key`).
#
# Keep this file out of production as-is — it demonstrates the mechanism; supply
# the key from your secret manager in a real deployment.
APP_API_KEYS_0_ID=example
APP_API_KEYS_0_NAME=example
APP_API_KEYS_0_KEY=example-api-key
# A config key with no owner resolves to a bare *service* principal; naming a
# PRINCIPAL_ID gives it a stable subject so `GET /me` returns a meaningful `sub`
# (issue #150). It is still a service principal — there is no users table here.
APP_API_KEYS_0_PRINCIPAL_ID=00000000-0000-0000-0000-000000000001
