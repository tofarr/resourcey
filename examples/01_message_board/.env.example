# Message-board example environment.
# Copy to `.env` and edit, or export these vars before running.

# Use the message-board config (SQLite by default).
RESOURCEY_CONFIG_CLASS=message_board.config.MessageBoardConfig

# Explicit resource set (JSON array of dotted import paths).
RESOURCEY_RESOURCES=["message_board.thread.Thread","message_board.message.Message"]

# SQLite file database (relative to the working directory).
RESOURCEY_DATABASE_PROTOCOL=sqlite+aiosqlite
RESOURCEY_DATABASE_DB_NAME=message_board.db

# App server.
RESOURCEY_HOST=0.0.0.0
RESOURCEY_PORT=8081
