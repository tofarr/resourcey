# MongoDB message-board example environment (v2).
#
# v2 does no .env loading of its own — pass this file explicitly:
#     uvicorn message_board.app:app --env-file .env --port 8082
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_MONGO_CONNECTIONS_<n>_NAME / _URL / _PASSWORD; cursors are encrypted with
# APP_ENCRYPTION_KEY_ID / _VALUE.

# `embedded://<db>` uses the in-process mongomock client (no external MongoDB
# required). Set to a real MongoDB URL (e.g.
# mongodb://localhost:27017/message_board) to use a real server — the database
# name is the URL path, as in any MongoDB connection string.
APP_MONGO_CONNECTIONS_0_NAME=main
APP_MONGO_CONNECTIONS_0_URL=embedded://message_board

# Cursor-encryption key. An absent key degrades to a loud dev default
# ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=message-board-dev-cursor-key
