# MongoDB message-board example environment.

# Explicit resource set (JSON array of dotted import paths).
RESOURCEY_RESOURCES=["message_board.thread.Thread","message_board.message.Message"]

# MongoDB connection. When empty or "embedded", the app uses the in-process
# mongomock server (no external MongoDB required). Set to a real MongoDB URL
# (e.g. mongodb://localhost:27017) to use a real server.
RESOURCEY_MONGO_URL=embedded
RESOURCEY_MONGO_DATABASE=message_board

# App server.
RESOURCEY_HOST=0.0.0.0
RESOURCEY_PORT=8082
