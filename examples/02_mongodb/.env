# MongoDB message-board example environment.

# Manifest import path (module:attr). The migrations CLI imports this to
# materialise the resource tables before Alembic diffs.
RESOURCEY_MANIFEST=message_board.app:manifest

# MongoDB connection. `embedded://<db>` uses the in-process mongomock server
# (no external MongoDB required). Set to a real MongoDB URL (e.g.
# mongodb://localhost:27017/message_board) to use a real server — the database
# name is the URL path, as in any MongoDB connection string.
RESOURCEY_DATABASE_URL=embedded://message_board
