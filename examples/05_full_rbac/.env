# Full-RBAC example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uv run --env-file .env uvicorn full_rbac.app:app --port 8085
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL; cursors are encrypted with
# APP_ENCRYPTION_KEY_ID / _VALUE.

# SQLite file database (relative to the working directory).
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///full_rbac.db

# Cursor-encryption key. An absent key degrades to a loud dev default
# ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=full-rbac-dev-cursor-key

# There is no APP_API_KEYS_* block here: unlike examples 03/04, this example
# stores its keys in the `api_keys` table, bound to their `users` row by
# `user_id` and kept only as a SHA-256 digest. They are seeded by
# `python -m full_rbac.seed` together with the users they name, so a key and the
# principal it resolves to cannot drift. The plaintexts live in that module
# (`admin-key` / `viewer-key` / `author-key`); an unseeded database rejects them
# with a 401.
