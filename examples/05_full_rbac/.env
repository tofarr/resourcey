# Full-RBAC example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uv run --env-file .env uvicorn full_rbac.app:app --port 8085
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL; cursors are encrypted with
# APP_ENCRYPTION_KEY_ID / _VALUE; accepted keys are APP_API_KEYS_<n>_ID / _KEY.

# SQLite file database (relative to the working directory).
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///full_rbac.db

# Cursor-encryption key. An absent key degrades to a loud dev default
# ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=full-rbac-dev-cursor-key

# Accepted API keys. Unlike example 04, the key does NOT carry roles: it is
# bound to a stored user id (`PRINCIPAL_ID`), and the store resolves that user's
# groups -> roles -> permissions per request. Seed the matching user rows with
# the migration / seed script (see README.md).
#
# The user ids here must exist in the `users` table for the roles to resolve.

APP_API_KEYS_0_ID=admin
APP_API_KEYS_0_NAME=admin
APP_API_KEYS_0_KEY=admin-key
APP_API_KEYS_0_PRINCIPAL_ID=00000000-0000-0000-0000-0000000000a0

APP_API_KEYS_1_ID=viewer
APP_API_KEYS_1_NAME=viewer
APP_API_KEYS_1_KEY=viewer-key
APP_API_KEYS_1_PRINCIPAL_ID=00000000-0000-0000-0000-0000000000b0

APP_API_KEYS_2_ID=author
APP_API_KEYS_2_NAME=author
APP_API_KEYS_2_KEY=author-key
APP_API_KEYS_2_PRINCIPAL_ID=00000000-0000-0000-0000-0000000000c0
