# Simple-roles example environment (v2).
#
# v2 does no .env loading of its own — pass this file explicitly:
#     uv run --env-file .env uvicorn simple_roles.app:app --port 8084
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL; cursors are encrypted with
# APP_ENCRYPTION_KEY_ID / _VALUE; accepted keys are APP_API_KEYS_<n>_ID / _KEY.

# SQLite file database (relative to the working directory).
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///simple_roles.db

# Cursor-encryption key. An absent key degrades to a loud dev default
# ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=simple-roles-dev-cursor-key

# Accepted API keys and the roles each authenticates as (issue #132). Roles are
# carried on the key's definition, so a presented key's roles need no DB lookup.
# A key with no roles authenticates but is denied everything (fail-closed).
#
# `PRINCIPAL_ID` names the principal a *config* key acts as; the `Owner` policy
# scopes `messages` rows (author_id) to it. Give the `user` key a UUID.

APP_API_KEYS_0_ID=admin
APP_API_KEYS_0_NAME=admin
APP_API_KEYS_0_KEY=admin-key
APP_API_KEYS_0_ROLES_0=ADMIN

APP_API_KEYS_1_ID=moderator
APP_API_KEYS_1_NAME=moderator
APP_API_KEYS_1_KEY=moderator-key
APP_API_KEYS_1_ROLES_0=MODERATOR

APP_API_KEYS_2_ID=user
APP_API_KEYS_2_NAME=user
APP_API_KEYS_2_KEY=user-key
APP_API_KEYS_2_PRINCIPAL_ID=11111111-1111-1111-1111-111111111111
APP_API_KEYS_2_ROLES_0=USER

APP_API_KEYS_3_ID=unroled
APP_API_KEYS_3_NAME=unroled
APP_API_KEYS_3_KEY=unroled-key
