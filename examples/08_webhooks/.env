# Webhooks example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uvicorn webhooks_example.app:app --env-file .env
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL / _PASSWORD; cursors are encrypted with
# APP_ENCRYPTION_KEY_ID / _VALUE; triggers are APP_TRIGGERS_<n>_*.

# SQLite file database (relative to the working directory).
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///webhooks_example.db

# Cursor-encryption key. An absent key degrades to a loud dev default
# ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=webhooks-example-dev-cursor-key

# --- Triggers (resourcey.triggers.trigger_config.TriggerConfig) -----------
#
# Attaches a LoggingWebhookTrigger to `messages` with NO change to the
# `messages` resource declaration -- the opt-in, config-driven rung
# (TriggeredDependencyBuilder.from_config). `threads` gets its trigger the
# other way: wired directly in webhooks_example/app.py via
# TriggeredResource(..., on_edit=[...]). See the app.py / README for both.
APP_TRIGGERS_0_RESOURCE_PATH=messages
APP_TRIGGERS_0_TRIGGER_KIND=webhooks_example.triggers.LoggingWebhookTrigger
APP_TRIGGERS_0_TRIGGER_NAME=slack-notify
APP_TRIGGERS_0_TRIGGER_URL=https://hooks.example.com/services/T000/B000/XXXX
