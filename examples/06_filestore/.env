# File-store example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uvicorn file_store_example.app:app --env-file .env --port 8086
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL / _PASSWORD; cursors and signed-URL
# capabilities are encrypted with APP_ENCRYPTION_KEY_ID / _VALUE.

# SQLite file database (relative to the working directory). The URL carries the
# full connection string; the scheme selects the driver.
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///file_store_example.db

# Cursor / capability-encryption key. An absent key degrades to a loud dev
# default ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=file-store-example-dev-cursor-key

# The byte medium. Unset selects LocalFileStore (the default); set MEDIUM_CLASS
# to a dotted path to switch media with no code change. The selected medium's
# own fields parse under the MEDIUM_ prefix.
#
#   Local file medium (default) — bytes under MEDIUM_ROOT:
#     MEDIUM_ROOT=./.resourcey_files
#
#   S3 medium — needs `resourcey[s3]` (boto3) and a bucket; it mints S3's own
#   native SigV4 pre-signed URLs, so no transfer endpoint is mounted:
#     MEDIUM_CLASS=resourcey.filestore.s3_file_store.S3FileStore
#     MEDIUM_BUCKET=my-bucket
#     MEDIUM_REGION=us-east-1
#
#   SQL blob medium — bytes in a `file_blobs` table on the same connection:
#     MEDIUM_CLASS=resourcey.filestore.sql_file_store.SqlFileStore
#     MEDIUM_CONNECTION_NAME=main
MEDIUM_ROOT=./.resourcey_files

# Capability TTLs (seconds) and an optional declared-size cap (bytes).
APP_UPLOAD_URL_TTL_SECONDS=900
APP_DOWNLOAD_URL_TTL_SECONDS=900
