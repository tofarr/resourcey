# OAuth / OIDC example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uv run --env-file .env uvicorn oauth_example.app:app --port 8087
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL; cursors / flow-state / session cookies are
# encrypted with APP_ENCRYPTION_KEY_ID / _VALUE; OAuth clients are
# APP_OAUTH_CLIENTS_<n>_*.

# SQLite file database (relative to the working directory).
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///oauth_example.db

# Cursor / flow-state / session-cookie encryption key. An absent key degrades to
# a loud dev default ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=oauth-example-dev-cursor-key

# The session cookie the callback mints (BFF posture). Its browser Max-Age is
# clamped down to the IdP token's expiry, so our session never outlives the
# provider's.
APP_SESSION_COOKIE_NAME=session
APP_SESSION_COOKIE_SECURE=false

# --- OAuth clients (the config rung) ---------------------------------------
#
# The fields split into two roles: the *verification* fields (issuer, jwks_uri,
# audience, algorithms) are what the authenticator reads per request; the *flow*
# fields (auth_url, token_url, refresh_url, client_secret, redirect_uri, scopes)
# are what the interactive flow reads. `roles` are the simple-roles vocabulary
# (#132) a token from this client authenticates as.
#
# `jwks_uri` is where the token's signing keys are fetched (and cached). For the
# self-contained demo it points at the dev provider the example fakes; a real
# deployment points it at the IdP.
APP_OAUTH_CLIENTS_0_ID=dev
APP_OAUTH_CLIENTS_0_PROVIDER=dev
APP_OAUTH_CLIENTS_0_ISSUER=https://dev-idp.example
APP_OAUTH_CLIENTS_0_JWKS_URI=https://dev-idp.example/jwks
APP_OAUTH_CLIENTS_0_AUDIENCE=oauth-example
APP_OAUTH_CLIENTS_0_ALGORITHMS=["RS256"]
APP_OAUTH_CLIENTS_0_CLIENT_ID=oauth-example
APP_OAUTH_CLIENTS_0_CLIENT_SECRET=dev-client-secret
APP_OAUTH_CLIENTS_0_AUTH_URL=https://dev-idp.example/authorize
APP_OAUTH_CLIENTS_0_TOKEN_URL=https://dev-idp.example/token
APP_OAUTH_CLIENTS_0_REFRESH_URL=https://dev-idp.example/token
APP_OAUTH_CLIENTS_0_REDIRECT_URI=http://localhost:8087/oauth/callback
APP_OAUTH_CLIENTS_0_SCOPES=["openid","email"]
APP_OAUTH_CLIENTS_0_ROLES=["USER"]
