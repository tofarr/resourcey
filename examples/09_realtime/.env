# Realtime example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uvicorn realtime_example.app:app --env-file .env
#
# Config blocks read one process-wide prefix (APP). Connection n is
# APP_SQL_CONNECTIONS_<n>_NAME / _URL / _PASSWORD; cursors are encrypted with
# APP_ENCRYPTION_KEY_ID / _VALUE.

# SQLite file database (relative to the working directory).
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///realtime_example.db

# Cursor-encryption key. An absent key degrades to a loud dev default
# ("changeme" + a warning); set a real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=realtime-example-dev-cursor-key

# --- Realtime channel (resourcey.realtime.realtime_config.RealtimeConfig) -
#
# CHANNEL_CLASS is unprefixed (a LazyField, exactly like FileStoreConfig's
# MEDIUM_CLASS) — left unset here, which selects InMemoryChannel, the
# single-process default with no extra dependency. Uncomment the two lines
# below (and `docker run -p 6379:6379 redis` or similar) to bridge real
# processes over Redis pub/sub instead — no code change either way, see
# realtime_example/app.py.
#
#   CHANNEL_CLASS=resourcey.realtime.realtime_redis_channel.RedisChannel
#   CHANNEL_URL=redis://localhost:6379/0

# How often the subscriber socket sends a keepalive ping (seconds).
APP_HEARTBEAT_SECONDS=30
