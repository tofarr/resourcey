# Durable-jobs example environment.
#
# The framework does no .env loading of its own — pass this file explicitly:
#     uv run --env-file .env uvicorn jobs_example.app:app --port 8090
#
# Config blocks read one process-wide prefix (APP).

# SQLite file database (relative to the working directory).
APP_SQL_CONNECTIONS_0_NAME=main
APP_SQL_CONNECTIONS_0_URL=sqlite+aiosqlite:///jobs.db

# Cursor-encryption key. An absent key degrades to a loud dev default; set a
# real value outside development.
APP_ENCRYPTION_KEY_ID=dev
APP_ENCRYPTION_KEY_VALUE=jobs-dev-cursor-key

# The job runner (issue #16). The sweep loop looks for claimable jobs and
# recovers stale claims every `SWEEP_INTERVAL_SECONDS`; `RUNNER_ENABLED` gates
# whether *this* process runs jobs (a web replica sets it false).
APP_JOBS_SWEEP_INTERVAL_SECONDS=2
APP_JOBS_MAX_CONCURRENT_JOBS=4
APP_JOBS_DEFAULT_MAX_ATTEMPTS=3
APP_JOBS_DEFAULT_MAX_SECONDS_FOR_RUN=3600
APP_JOBS_RUNNER_ENABLED=true

# Accepted API keys and their roles (issue #132). Reads are public; a USER may
# enqueue / read / cancel its own jobs, an ADMIN sees everything.
APP_API_KEYS_0_ID=admin
APP_API_KEYS_0_NAME=admin
APP_API_KEYS_0_KEY=admin-key
APP_API_KEYS_0_ROLES_0=ADMIN

APP_API_KEYS_1_ID=user
APP_API_KEYS_1_NAME=user
APP_API_KEYS_1_KEY=user-key
APP_API_KEYS_1_PRINCIPAL_ID=11111111-1111-1111-1111-111111111111
APP_API_KEYS_1_ROLES_0=USER

# A scheduled task that enqueues a durable EchoJobDetails job each tick (the
# resourcey.tasks -> resourcey.jobs bridge). Remove this entry to disable it.
APP_BACKGROUND_TASKS_0_KIND=jobs_example.tasks.EnqueueEchoConfig
APP_BACKGROUND_TASKS_0_NAME=enqueue-echo
APP_BACKGROUND_TASKS_0_SCHEDULE="*/30 * * * *"
APP_BACKGROUND_TASKS_0_ENABLED=true
APP_BACKGROUND_TASKS_0_MESSAGE="scheduled echo from the task"
